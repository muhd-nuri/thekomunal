# Site
NEXT_PUBLIC_SITE_URL=https://thekomunal.com
NEXT_PUBLIC_WHATSAPP_NUMBER=601126685945         # guest WhatsApp, digits only (same as the phone, 011-2668 5945)
NEXT_PUBLIC_META_PIXEL_ID=1106776348189843
# Google Analytics — the two tags the old WordPress site (Site Kit) loaded. Build-time.
# Leave both empty locally so dev traffic never reaches the live property.
NEXT_PUBLIC_GA_MEASUREMENT_ID=                    # GA4 property, production: G-SDYJQFKYKB
NEXT_PUBLIC_GOOGLE_TAG_ID=                        # Site Kit's Google tag, production: GT-MQBK3NN9

# Phase 2 — local PostgreSQL (no third-party DB) + Telegram booking group
DATABASE_URL=postgres://user:pass@localhost:5432/komunal
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
IP_HASH_SALT=

# Phase 4 — admin (Better Auth) + CMS uploads
BETTER_AUTH_SECRET=                               # openssl rand -base64 32
BETTER_AUTH_URL=https://thekomunal.com
ADMIN_EMAIL=                                      # first admin, created by `bun run db:seed`
ADMIN_PASSWORD=                                   # 12+ characters; change it after first sign-in
ADMIN_NAME=Komunal Admin
UPLOAD_DIR=/var/lib/komunal/uploads               # absolute, outside the app; empty in dev = ./uploads
